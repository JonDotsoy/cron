{
  "name": "@jondotsoy/cron",
  "description": "Cron expression parser and scheduler that generates execution times based on cron syntax",
  "keywords": [
    "cron",
    "cron-parser",
    "scheduler",
    "cron-expression",
    "temporal",
    "datetime",
    "scheduling"
  ],
  "module": "./lib/esm/cron.js",
  "types": "./lib/types/cron.d.ts",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/types/cron.d.ts",
      "import": "./lib/esm/cron.js"
    },
    "./colloquial-cron-format": {
      "types": "./lib/types/idioms/colloquial-cron-format.d.ts",
      "import": "./lib/esm/idioms/colloquial-cron-format.js"
    },
    "./utils": {
      "types": "./lib/types/utils.d.ts",
      "import": "./lib/esm/utils.js"
    }
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.esm.json && tsc -p tsconfig.types.json",
    "lint": "prettier --check .",
    "fmt": "prettier --write .",
    "examples": "bun run examples/examples.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "prettier": "3.6.2"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "temporal-polyfill": "0.3.0"
  },
  "license": "MIT",
  "author": "Jonathan Delgado <hi@jon.soy>",
  "version": "0.5.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/JonDotsoy/cron.git"
  },
  "homepage": "https://cron.jon.soy"
}
