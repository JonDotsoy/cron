---

---

<div class="space-y-8">
    <div class="flex justify-between items-center mb-4">
        <select 
            id="language-selector"
            data-testid="language-selector"
            class="border-2 border-gray-300 rounded-lg px-4 py-2 text-sm font-medium focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-sm hover:border-gray-400 cursor-pointer"
        >
            <option value="en">English</option>
            <option value="es">Español</option>
        </select>
        <label class="flex items-center gap-2 cursor-pointer">
            <input 
                type="checkbox" 
                id="danger-mode"
                data-testid="danger-mode"
                class="w-4 h-4 text-red-600 bg-gray-100 border-gray-300 rounded focus:ring-red-500 focus:ring-2 cursor-pointer"
            />
            <span class="text-sm font-medium text-gray-700">🔥 Danger Mode</span>
        </label>
    </div>

    <div class="bg-gradient-to-r from-blue-50 to-indigo-50 rounded-2xl p-8 shadow-lg">
        <h2 class="text-3xl md:text-4xl text-center font-semibold text-gray-800 mb-2">
            "<span id="show-format" class="text-indigo-600"></span>"
        </h2>
    </div>

    <div class="flex gap-3 items-center">
        <input
            id="cron-expresion"
            type="text"
            class="flex-1 border-2 border-gray-300 rounded-lg px-4 py-3 text-xl text-center font-mono focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:border-transparent transition-all shadow-sm hover:border-gray-400"
            placeholder="* * * * *"
            data-testid="input-cron-expression"
        />
        <button 
            id="btn-random" 
            class="bg-indigo-600 hover:bg-indigo-700 text-white p-3 rounded-lg transition-all duration-200 shadow-md hover:shadow-lg active:scale-95 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2"
            title="Generate random cron"
            data-testid="btn-random"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="icon icon-tabler icons-tabler-outline icon-tabler-arrows-shuffle"
            >
                <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                <path d="M18 4l3 3l-3 3"></path>
                <path d="M18 20l3 -3l-3 -3"></path>
                <path d="M3 7h3a5 5 0 0 1 5 5a5 5 0 0 0 5 5h5"></path>
                <path d="M21 7h-5a4.978 4.978 0 0 0 -3 1m-4 8a4.984 4.984 0 0 1 -3 1h-3"></path>
            </svg>
        </button>
    </div>
    <div class="flex flex-wrap gap-2 justify-center">
        <span data-part="0" class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium transition-colors">Minute</span>
        <span data-part="1" class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium transition-colors">Hour</span>
        <span data-part="2" class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium transition-colors">Day</span>
        <span data-part="3" class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium transition-colors">Month</span>
        <span data-part="4" class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium transition-colors">Weekday</span>
        <span data-part="5" class="px-3 py-1 bg-gray-100 text-gray-700 rounded-full text-sm font-medium transition-colors">Year</span>
    </div>
    <div class="text-sm text-gray-600 hidden">
        <span class="font-medium">Selection:</span>
        <span id="selection-info" class="ml-2 text-indigo-600"></span>
    </div>
</div>

<script>
    import { ColloquialCronFormat } from "../../../src/idioms/colloquial-cron-format";
    import { CronRandom } from "../utils/cron-random";
    import { sessionStore } from "./session";

    const btnRandom = document.getElementById("btn-random");
    const languageSelector = document.getElementById("language-selector") as HTMLSelectElement;
    const dangerModeCheckbox = document.getElementById("danger-mode") as HTMLInputElement;
    const input = document.getElementById("cron-expresion") as HTMLInputElement;
    const selectionInfo = document.getElementById("selection-info") as HTMLElement;

    const cronParts = ["minute", "hour", "day", "month", "weekday"];

    const randomCron = () => {
        return CronRandom();
    };

    const updateLanguageOptions = () => {
        const isDangerMode = dangerModeCheckbox.checked;
        const currentValue = languageSelector.value;
        
        if (isDangerMode) {
            if (languageSelector.options.length === 2) {
                const option = document.createElement("option");
                option.value = "es-CL-Flaite";
                option.textContent = "Español Flaite 🇨🇱";
                languageSelector.appendChild(option);
            }
        } else {
            if (languageSelector.options.length === 3) {
                if (currentValue === "es-CL-Flaite") {
                    languageSelector.value = "es";
                    sessionStore.set({ ...sessionStore.get(), locale: "es" });
                    updateFormat();
                }
                languageSelector.remove(2);
            }
        }
    };

    const syncFromStore = () => {
        const state = sessionStore.get();
        languageSelector.value = state.locale;
        dangerModeCheckbox.checked = state.damageMode === "danger";
        input.value = state.cronExpression;
        updateLanguageOptions();
        updateFormat();
    };

    const handleDangerModeChange = () => {
        updateLanguageOptions();
        sessionStore.set({
            ...sessionStore.get(),
            damageMode: dangerModeCheckbox.checked ? "danger" : "normal"
        });
    };

    const getSelectedCronPart = () => {
        const value = input.value;
        const selectionStart = input.selectionStart || 0;
        
        if (!value) return null;
        
        const parts = value.split(/\s+/).filter(p => p.length > 0);
        let currentPos = 0;
        
        for (let i = 0; i < parts.length; i++) {
            const partStart = currentPos;
            const partEnd = currentPos + parts[i].length;
            
            if (selectionStart >= partStart && selectionStart <= partEnd) {
                return { index: i, name: cronParts[i] || `part ${i}`, value: parts[i] };
            }
            
            currentPos = partEnd;
            while (currentPos < value.length && value[currentPos] === ' ') {
                currentPos++;
            }
        }
        
        return null;
    };

    const updateSelectionInfo = () => {
        const selectedPart = getSelectedCronPart();
        const badges = document.querySelectorAll("[data-part]");
        
        badges.forEach((badge) => {
            badge.classList.remove("bg-indigo-600", "text-white");
            badge.classList.add("bg-gray-100", "text-gray-700");
        });
        
        if (selectedPart) {
            selectionInfo.textContent = `${selectedPart.name} (${selectedPart.value})`;
            const selectedBadge = document.querySelector(`[data-part="${selectedPart.index}"]`);
            if (selectedBadge) {
                selectedBadge.classList.remove("bg-gray-100", "text-gray-700");
                selectedBadge.classList.add("bg-indigo-600", "text-white");
            }
        } else {
            selectionInfo.textContent = "";
        }
    };

    const highlightCode = (code: string) => {
        return code
            .replace(/\b(import|from|const|new)\b/g, '<span class="text-purple-400">$1</span>')
            .replace(/\b(console)\b/g, '<span class="text-yellow-400">$1</span>')
            .replace(/\.(log|format)\b/g, '.<span class="text-blue-400">$1</span>')
            .replace(/"([^"]*)"/g, '<span class="text-green-400">"$1"</span>')
            .replace(/\/\/ (.*)/g, '<span class="text-gray-500">// $1</span>');
    };

    const updateCodeExample = () => {
        const codeExample = document.getElementById("code-example");
        if (!codeExample) return;
        
        const language = languageSelector.value;
        const cronExpression = input.value || "* * * * *";
        const output = document.getElementById("show-format")?.textContent || "";
        
        const code = `import { Cron, CronFormat } from "@jondotsoy/cron";

const cronFormat = new CronFormat("${language}");
const result = cronFormat.format("${cronExpression}");

console.log(result);
// Output: "${output}"`;
        
        codeExample.innerHTML = highlightCode(code);
    };

    const updateFormat = () => {
        const showFormat = document.getElementById("show-format") as HTMLElement;
        const language = languageSelector.value as "en" | "es";
        const cronFormat = new ColloquialCronFormat(language);
        
        if (input.value) {
            const parts = cronFormat.formatToParts(input.value);
            showFormat.innerHTML = parts
                .map((part) => part.value)
                .join(" ");
        }
        updateSelectionInfo();
        updateCodeExample();
    };

    const rand = () => {
        const valueRandom = randomCron();
        const isDangerMode = dangerModeCheckbox.checked;
        const languages = isDangerMode ? ["en", "es", "es-CL-Flaite"] : ["en", "es"];
        const randomLanguage = languages[Math.floor(Math.random() * languages.length)];
        
        sessionStore.set({
            locale: randomLanguage,
            damageMode: isDangerMode ? "danger" : "normal",
            cronExpression: valueRandom
        });
    };

    const init = () => {
        const state = sessionStore.get();
        
        // Si no hay valor en el store, generar uno random
        if (!state.cronExpression || state.cronExpression === "* * * * *") {
            rand();
        } else {
            syncFromStore();
        }
    };

    // Suscribirse a cambios en el store
    sessionStore.subscribe(syncFromStore);

    input?.addEventListener("click", updateSelectionInfo);
    input?.addEventListener("keyup", updateSelectionInfo);
    input?.addEventListener("select", updateSelectionInfo);
    
    let inputTimeout: number | undefined;
    const handleInputChange = () => {
        updateFormat();
        if (inputTimeout) {
            clearTimeout(inputTimeout);
        }
        inputTimeout = setTimeout(() => {
            sessionStore.set({
                ...sessionStore.get(),
                cronExpression: input.value
            });
        }, 300);
    };

    const handleInputBlur = () => {
        if (inputTimeout) {
            clearTimeout(inputTimeout);
        }
        sessionStore.set({
            ...sessionStore.get(),
            cronExpression: input.value
        });
        updateFormat();
    };

    input?.addEventListener("input", handleInputChange);
    input?.addEventListener("change", handleInputBlur);
    input?.addEventListener("blur", handleInputBlur);
    btnRandom?.addEventListener("click", rand);
    languageSelector?.addEventListener("change", () => {
        sessionStore.set({
            ...sessionStore.get(),
            locale: languageSelector.value
        });
        updateFormat();
    });
    dangerModeCheckbox?.addEventListener("change", handleDangerModeChange);
    
    init();
</script>
