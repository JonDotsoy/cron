---
import "../styles/global.css";
import CronDemo from "../components/cron-demo.astro";
import Code from "../components/code.astro";

const code = `import { Cron, {{class-cron-format}} } from "{{cron-module-name}}";
const cron = new Cron("{{cron-expression}}");

new {{class-cron-format}}("{{locale}}").format(cron);
// "{{cron-formated}}"
`
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon-air-balloon.svg" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content="Interactive web demo for the Cron Format library with human-readable cron expression formatting. Multi-language support and URL sharing." />
		<meta name="keywords" content="cron, cron expression, cron format, scheduler, task scheduling, human-readable, demo, astro" />
		<meta name="author" content="JonDotsoy" />
		<meta property="og:title" content="Cron Format Demo" />
		<meta property="og:description" content="Interactive demo for formatting cron expressions in human-readable format with multi-language support" />
		<meta property="og:type" content="website" />
		<meta property="og:url" content="https://github.com/JonDotsoy/cron" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content="Cron Format Demo" />
		<meta name="twitter:description" content="Interactive demo for formatting cron expressions in human-readable format" />
		<title>Cron Format Demo - Human-Readable Cron Expressions</title>
	</head>
	<body>
		<div class="container mx-auto">
			<div class="py-6">
				<CronDemo />
			</div>
			<div class="mt-8">
				<h2 class="text-2xl font-semibold text-gray-800 mb-4">Code Example</h2>
				<Code data-testid="code-1" code={code} />
			</div>
			<div class="text-center mt-8">
				<a href="https://github.com/JonDotsoy/cron" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:text-blue-800 underline">
					View on GitHub
				</a>
			</div>
		</div>
	</body>
</html>
